# Base URL of the TaskBuddy NestJS backend the mobile app talks to.
#
# Leave unset to use the deployed backend (https://taskbuddy-1d48.onrender.com).
EXPO_PUBLIC_API_URL=

# Optional fallback, used ONLY when the primary above fails a health check at
# app start. Lets you keep working against a local backend when the deployed
# one is down or mid-deploy, without editing files.
#
# The choice is made once per app launch and logged — the app never drifts
# between backends mid-session, so you always know which one you are on.
#
#   Android emulator:  run `adb reverse tcp:3000 tcp:3000`, then use
#                      EXPO_PUBLIC_API_URL_FALLBACK=http://localhost:3000
#   Physical device:   use your machine's LAN IP (NOT localhost — the phone
#                      cannot reach the dev machine's loopback). Find it with
#                      `ipconfig` (Windows) / `ifconfig` (macOS/Linux):
#                      EXPO_PUBLIC_API_URL_FALLBACK=http://192.168.1.20:3000
EXPO_PUBLIC_API_URL_FALLBACK=

# Only EXPO_PUBLIC_* variables are exposed to the app, and they are inlined at
# BUILD time — restart Expo with `--clear` after changing either value or the
# old one stays baked into the bundle.

# Google OAuth credentials have moved to the backend.
# The mobile app no longer contacts Google directly — the NestJS backend
# handles the full OAuth flow. See backend/.env.example for the required vars.
