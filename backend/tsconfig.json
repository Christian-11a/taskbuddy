{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node", "jest"],
    "incremental": true,
    // Keep the incremental cache inside the output directory. nest-cli.json sets
    // `deleteOutDir: true`, so `nest start --watch` wipes dist/ on every launch —
    // with the cache at the project root it survives that wipe, tsc concludes the
    // deleted output is still current, emits nothing, and `node dist/main` fails
    // with MODULE_NOT_FOUND. Inside dist/ the two are deleted together.
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
