# Supabase project (Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never ship to a client

# Recommendation model service (ml-service/)
ML_SERVICE_URL=http://localhost:8000

# API
PORT=3000
# Comma-separated browser origins. Set both to preserve local web access.
WEB_CORS_ORIGINS=http://localhost:3000,https://taskbuddy-nine-zeta.vercel.app
# How many proxies sit in front of this API. Defaults to 1, which is right on
# Render. The rate limiter needs it: without it every request behind the proxy
# arrives from the same address, the limiter sees the whole platform as one
# client, and one abusive caller locks everybody out. It is also what stops a
# client's own X-Forwarded-For from being a way around the limit. Set to 0 only
# when the API is exposed directly. See BACKEND_SCHEMA.md §28.4.
TRUST_PROXY_HOPS=1

# Google OAuth — server-side only (Web Application client from Google Cloud Console)
# See docs/google-auth-setup.md for full setup instructions.
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-oauth-client-secret
GOOGLE_CALLBACK_URL=https://taskbuddy-kpek.onrender.com/auth/google/callback
GOOGLE_STATE_SECRET=generate-with: openssl rand -hex 32

# Stripe — payments (wallet top-up) and Stripe Identity (provider verification).
# See docs/stripe-setup.md. Missing values are a boot warning, not a boot failure:
# the API runs fine without them and returns 503 only from /payments/* endpoints.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in the Dashboard.
# Each endpoint has its OWN secret — a test-mode secret will not verify live events.
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional. The API version handed to the mobile SDK with its ephemeral key.
# Only set this when @stripe/stripe-react-native requires a newer one.
STRIPE_MOBILE_API_VERSION=2025-01-27

# Optional. This API's own public origin, used to build the URLs Stripe Checkout
# returns the browser to. Derived from the request when unset, which is right
# locally and behind Render's proxy — set it only if that guess is ever wrong.
PUBLIC_API_URL=https://taskbuddy-kpek.onrender.com

# Expo push notifications.
# Optional — only required once "Enhanced Security for Push Notifications" is
# switched on for the Expo project (expo.dev → Project → Settings → Access tokens).
EXPO_ACCESS_TOKEN=

# Scheduler ticks (migration 0025).
# CRON_DRIVER=pg_cron stands the in-process @Cron decorators down and lets
# Postgres drive the sweeps over HTTP instead — set this wherever the API
# sleeps or scales to zero, since a sleeping process delivers no notifications.
# Unset (the default) keeps the in-process schedulers authoritative.
CRON_DRIVER=
# Shared secret for POST /internal/tick/*. Must equal the value stored in the
# database Vault as `taskbuddy_cron_secret` (section 2 of migration 0025).
# Unset means those endpoints return 503 rather than running unauthenticated.
# Generate with: openssl rand -hex 32
CRON_SECRET=
